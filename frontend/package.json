{
  "name": "gabinete-web",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4300",
    "build": "ng build",
    "build:pages": "ng build --configuration production --base-href /crm/ && node scripts/prepare-github-pages.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "mcp": "ng mcp",
    "mcp:check": "node scripts/check-angular-mcp.mjs",
    "test:ui": "playwright test",
    "format": "prettier --write src scripts tests playwright.config.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "pdf-lib": "^1.17.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@axe-core/playwright": "^4.14.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.65.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
