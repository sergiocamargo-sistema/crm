rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Toda autorização e toda operação de negócio passam pela API administrativa.
    // O Admin SDK usa IAM; estas regras bloqueiam o acesso direto pelo navegador.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
