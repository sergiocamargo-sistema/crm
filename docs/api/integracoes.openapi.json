{
  "openapi": "3.1.1",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Gabinete CRM — integrações indispensáveis",
    "version": "1.0.0-draft.3",
    "description": "Contrato proposto, não implementado. Planejamento v0.14, 16/11/2026, America/Sao_Paulo. Cada operação possui consumidor/ação identificados. Cadastro e edição de agregados são transacionais. Rotas futuras sem tela definida foram retiradas. Valores de limites são propostas, não capacidade medida."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Base proposta; nenhum servidor é instalado/publicado por este documento."
    }
  ],
  "tags": [
    {
      "name": "Operação técnica",
      "description": "Operações necessárias às telas de Operação técnica."
    }
  ],
  "paths": {
    "/saude": {
      "get": {
        "operationId": "get_saude",
        "tags": [
          "Operação técnica"
        ],
        "summary": "Verificar prontidão mínima do serviço",
        "description": "Retorna prontidão sem configuração/segredos; 503 se indisponível. É consumidor de infraestrutura, não chamada para montar tela.",
        "security": [],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Dados prontos para a tela, no alcance autorizado.",
            "headers": {
              "Cache-Control": {
                "description": "Sem cache público de dados pessoais/QR.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Saude"
                },
                "example": {
                  "estado": "pronto",
                  "verificadoEm": "2026-11-16T17:00:00Z"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ErroPublico400"
          },
          "422": {
            "$ref": "#/components/responses/ErroPublico422"
          },
          "429": {
            "$ref": "#/components/responses/ErroPublico429"
          },
          "500": {
            "$ref": "#/components/responses/ErroPublico500"
          },
          "503": {
            "$ref": "#/components/responses/ErroPublico503"
          }
        },
        "x-tela": "Monitor externo",
        "x-acao-frontend": "Verificar prontidão mínima do serviço",
        "x-consumidor": "integracao",
        "x-implementado": false,
        "x-permissoes": [],
        "x-idempotencia": "nao_aplicavel",
        "x-backend-resolve": []
      }
    },
    "/webhooks/whatsapp/{conectorId}": {
      "post": {
        "operationId": "post_webhooks_whatsapp_conectorId",
        "tags": [
          "Operação técnica"
        ],
        "summary": "Persistir evento normalizado do conector",
        "description": "Não é payload nativo de fornecedor escolhido. Adaptador autentica provedor e assina HMAC-SHA256 de timestamp+'.'+corpo bruto com segredo próprio. Validar janela temporal e conexão; deduplicar conectorId+eventoId, persistir antes do 202 e reconciliar eventos antigos.",
        "security": [
          {
            "webhookHmac": []
          }
        ],
        "parameters": [
          {
            "name": "conectorId",
            "in": "path",
            "required": true,
            "description": "Identificador interno UUID.",
            "schema": {
              "type": "string",
              "description": "Identificador interno UUID.",
              "examples": [
                "11111111-1111-4111-8111-111111111111"
              ],
              "format": "uuid"
            }
          },
          {
            "name": "X-Webhook-Timestamp",
            "in": "header",
            "required": true,
            "description": "Janela proposta de 300s; retry reassina e mantém eventoId.",
            "schema": {
              "type": "string",
              "description": "Unix timestamp do envio.",
              "examples": [
                "1794848400"
              ],
              "pattern": "^[0-9]+$"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Aceito para processamento; ainda não representa efeito externo concluído.",
            "headers": {
              "Cache-Control": {
                "description": "Sem cache público de dados pessoais/QR.",
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              },
              "X-Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvisoAceito"
                },
                "example": {
                  "aceito": true
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ErroPublico400"
          },
          "401": {
            "$ref": "#/components/responses/ErroPublico401"
          },
          "404": {
            "$ref": "#/components/responses/ErroPublico404"
          },
          "409": {
            "$ref": "#/components/responses/ErroPublico409"
          },
          "422": {
            "$ref": "#/components/responses/ErroPublico422"
          },
          "429": {
            "$ref": "#/components/responses/ErroPublico429"
          },
          "500": {
            "$ref": "#/components/responses/ErroPublico500"
          },
          "503": {
            "$ref": "#/components/responses/ErroPublico503"
          }
        },
        "x-tela": "Adaptador WhatsApp",
        "x-acao-frontend": "Persistir evento normalizado do conector",
        "x-consumidor": "integracao",
        "x-implementado": false,
        "x-permissoes": [],
        "x-idempotencia": "nao_aplicavel",
        "x-backend-resolve": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WebhookWhatsapp"
              },
              "example": {
                "eventoId": "evento-provedor-exemplo",
                "ocorridoEm": "2026-11-16T17:00:00Z",
                "evento": {
                  "tipo": "mensagem_recebida",
                  "conexaoId": "11111111-1111-4111-8111-111111111111",
                  "mensagemExternaId": "msg-provedor-exemplo",
                  "contatoExterno": "+5511999990000",
                  "texto": "Gostaria de saber o andamento.",
                  "midias": [
                    {
                      "referencia": "midia-exemplo",
                      "mimeType": "audio/ogg"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErroCampo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "campo": {
            "type": "string",
            "description": "Caminho exato no formulário, inclusive chave de item.",
            "examples": [
              "contatos[telefone-1].valor"
            ]
          },
          "codigo": {
            "type": "string",
            "description": "Código estável.",
            "examples": [
              "VALOR_INVALIDO"
            ]
          },
          "mensagem": {
            "type": "string",
            "description": "Mensagem para exibir junto ao campo.",
            "examples": [
              "Revise o telefone informado."
            ]
          }
        },
        "required": [
          "campo",
          "codigo",
          "mensagem"
        ],
        "description": "ErroCampo"
      },
      "AvisoAceito": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "aceito": {
            "type": "boolean",
            "const": true,
            "description": "Aceito para processamento, sem comprovar entrega/exibição."
          }
        },
        "required": [
          "aceito"
        ],
        "description": "AvisoAceito"
      },
      "Saude": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "estado": {
            "type": "string",
            "description": "Estado mínimo, sem diagnósticos sensíveis.",
            "examples": [
              "pronto"
            ],
            "enum": [
              "pronto",
              "indisponivel"
            ]
          },
          "verificadoEm": {
            "type": "string",
            "description": "Instante em UTC; apresentação no fuso da interface.",
            "examples": [
              "2026-11-16T17:00:00Z"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "estado",
          "verificadoEm"
        ],
        "description": "Saude"
      },
      "EventoMensagemEntrada": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tipo": {
            "type": "string",
            "description": "Evento normalizado pelo nosso adaptador.",
            "examples": [
              "mensagem_recebida"
            ],
            "enum": [
              "mensagem_recebida"
            ]
          },
          "conexaoId": {
            "type": "string",
            "description": "Identificador interno UUID.",
            "examples": [
              "11111111-1111-4111-8111-111111111111"
            ],
            "format": "uuid"
          },
          "mensagemExternaId": {
            "type": "string",
            "description": "Chave no provedor.",
            "examples": [
              "msg-provedor-exemplo"
            ]
          },
          "contatoExterno": {
            "type": "string",
            "description": "Contato, não identidade da pessoa.",
            "examples": [
              "+5511999990000"
            ]
          },
          "texto": {
            "anyOf": [
              {
                "type": "string",
                "description": "Texto original.",
                "examples": [
                  "Gostaria de saber o andamento."
                ]
              },
              {
                "type": "null"
              }
            ],
            "description": "Texto original."
          },
          "midias": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "referencia": {
                  "type": "string",
                  "description": "Referência opaca do adaptador, não URL arbitrária.",
                  "examples": [
                    "midia-exemplo"
                  ]
                },
                "mimeType": {
                  "type": "string",
                  "description": "Tipo declarado sujeito a verificação.",
                  "examples": [
                    "audio/ogg"
                  ]
                }
              },
              "required": [
                "referencia",
                "mimeType"
              ]
            },
            "minItems": 0,
            "maxItems": 100,
            "description": "Lista de valores."
          }
        },
        "required": [
          "tipo",
          "conexaoId",
          "mensagemExternaId",
          "contatoExterno",
          "midias"
        ],
        "description": "EventoMensagemEntrada"
      },
      "EventoMensagemEstado": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tipo": {
            "type": "string",
            "description": "Confirmação de estado.",
            "examples": [
              "mensagem_estado"
            ],
            "enum": [
              "mensagem_estado"
            ]
          },
          "conexaoId": {
            "type": "string",
            "description": "Identificador interno UUID.",
            "examples": [
              "11111111-1111-4111-8111-111111111111"
            ],
            "format": "uuid"
          },
          "mensagemExternaId": {
            "type": "string",
            "description": "ID no provedor.",
            "examples": [
              "msg-provedor-exemplo"
            ]
          },
          "estado": {
            "type": "string",
            "description": "Não regredir por evento atrasado.",
            "examples": [
              "aceita_provedor"
            ],
            "enum": [
              "aceita_provedor",
              "entregue",
              "lida",
              "falha"
            ]
          }
        },
        "required": [
          "tipo",
          "conexaoId",
          "mensagemExternaId",
          "estado"
        ],
        "description": "EventoMensagemEstado"
      },
      "EventoConexaoEstado": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tipo": {
            "type": "string",
            "description": "Estado da sessão.",
            "examples": [
              "conexao_estado"
            ],
            "enum": [
              "conexao_estado"
            ]
          },
          "conexaoId": {
            "type": "string",
            "description": "Identificador interno UUID.",
            "examples": [
              "11111111-1111-4111-8111-111111111111"
            ],
            "format": "uuid"
          },
          "estado": {
            "type": "string",
            "description": "Reconciliar evidências fora de ordem.",
            "examples": [
              "conectado"
            ],
            "enum": [
              "conectado",
              "desconectado",
              "aguardando_autenticacao",
              "falha"
            ]
          }
        },
        "required": [
          "tipo",
          "conexaoId",
          "estado"
        ],
        "description": "EventoConexaoEstado"
      },
      "WebhookWhatsapp": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "eventoId": {
            "type": "string",
            "description": "Deduplicar adaptador+eventoId.",
            "examples": [
              "evento-provedor-exemplo"
            ]
          },
          "ocorridoEm": {
            "type": "string",
            "description": "Instante em UTC; apresentação no fuso da interface.",
            "examples": [
              "2026-11-16T17:00:00Z"
            ],
            "format": "date-time"
          },
          "evento": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/EventoMensagemEntrada"
              },
              {
                "$ref": "#/components/schemas/EventoMensagemEstado"
              },
              {
                "$ref": "#/components/schemas/EventoConexaoEstado"
              }
            ]
          }
        },
        "required": [
          "eventoId",
          "ocorridoEm",
          "evento"
        ],
        "description": "WebhookWhatsapp"
      },
      "ProblemaPublico": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "description": "Tipo do problema.",
            "examples": [
              "urn:gabinete:validacao"
            ],
            "format": "uri"
          },
          "title": {
            "type": "string",
            "description": "Título.",
            "examples": [
              "Revise os dados"
            ]
          },
          "status": {
            "type": "integer",
            "description": "HTTP correspondente.",
            "minimum": 400,
            "examples": [
              422
            ],
            "maximum": 599
          },
          "detail": {
            "type": "string",
            "description": "Orientação segura.",
            "examples": [
              "Nenhum dado do formulário foi salvo."
            ]
          },
          "codigo": {
            "type": "string",
            "description": "Código de domínio.",
            "examples": [
              "VALIDACAO"
            ]
          },
          "requestId": {
            "type": "string",
            "description": "Correlação.",
            "examples": [
              "req-exemplo"
            ]
          },
          "erros": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErroCampo"
            },
            "minItems": 0,
            "maxItems": 100,
            "description": "Lista de valores."
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "codigo",
          "requestId"
        ],
        "description": "Erro público sem candidatos/IDs internos da base ou detalhes de privilégios."
      }
    },
    "responses": {
      "ErroPublico400": {
        "description": "Sintaxe inválida.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemaPublico"
            },
            "example": {
              "type": "urn:gabinete:validacao",
              "title": "Sintaxe inválida.",
              "status": 400,
              "detail": "Nenhum dado do formulário foi salvo.",
              "codigo": "HTTP_400",
              "requestId": "req-exemplo"
            }
          }
        }
      },
      "ErroPublico401": {
        "description": "Sessão ausente, expirada ou revogada.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemaPublico"
            },
            "example": {
              "type": "urn:gabinete:validacao",
              "title": "Sessão ausente, expirada ou revogada.",
              "status": 401,
              "detail": "Nenhum dado do formulário foi salvo.",
              "codigo": "HTTP_401",
              "requestId": "req-exemplo"
            }
          }
        }
      },
      "ErroPublico404": {
        "description": "Recurso inexistente ou fora do alcance.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemaPublico"
            },
            "example": {
              "type": "urn:gabinete:validacao",
              "title": "Recurso inexistente ou fora do alcance.",
              "status": 404,
              "detail": "Nenhum dado do formulário foi salvo.",
              "codigo": "HTTP_404",
              "requestId": "req-exemplo"
            }
          }
        }
      },
      "ErroPublico409": {
        "description": "Conflito de negócio/duplicidade/dependência/estado; o formulário inteiro não é parcialmente salvo.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemaPublico"
            },
            "example": {
              "type": "urn:gabinete:validacao",
              "title": "Conflito de negócio/duplicidade/dependência/estado; o formulário inteiro não é parcialmente salvo.",
              "status": 409,
              "detail": "Nenhum dado do formulário foi salvo.",
              "codigo": "HTTP_409",
              "requestId": "req-exemplo"
            }
          }
        }
      },
      "ErroPublico422": {
        "description": "Campos/combinações inválidos, com caminhos para o formulário.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemaPublico"
            },
            "example": {
              "type": "urn:gabinete:validacao",
              "title": "Campos/combinações inválidos, com caminhos para o formulário.",
              "status": 422,
              "detail": "Nenhum dado do formulário foi salvo.",
              "codigo": "HTTP_422",
              "requestId": "req-exemplo",
              "erros": [
                {
                  "campo": "contatos[telefone-1].valor",
                  "codigo": "VALOR_INVALIDO",
                  "mensagem": "Revise o telefone informado."
                }
              ]
            }
          }
        }
      },
      "ErroPublico429": {
        "description": "Limite de tentativas/requisições excedido.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemaPublico"
            },
            "example": {
              "type": "urn:gabinete:validacao",
              "title": "Limite de tentativas/requisições excedido.",
              "status": 429,
              "detail": "Nenhum dado do formulário foi salvo.",
              "codigo": "HTTP_429",
              "requestId": "req-exemplo"
            }
          }
        }
      },
      "ErroPublico500": {
        "description": "Falha interna sem detalhes sensíveis.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemaPublico"
            },
            "example": {
              "type": "urn:gabinete:validacao",
              "title": "Falha interna sem detalhes sensíveis.",
              "status": 500,
              "detail": "Nenhum dado do formulário foi salvo.",
              "codigo": "HTTP_500",
              "requestId": "req-exemplo"
            }
          }
        }
      },
      "ErroPublico503": {
        "description": "Dependência temporariamente indisponível.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemaPublico"
            },
            "example": {
              "type": "urn:gabinete:validacao",
              "title": "Dependência temporariamente indisponível.",
              "status": 503,
              "detail": "Nenhum dado do formulário foi salvo.",
              "codigo": "HTTP_503",
              "requestId": "req-exemplo"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "webhookHmac": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Webhook-Signature",
        "description": "sha256=<hex>; HMAC-SHA256 sobre timestamp+'.'+bytes do corpo bruto, segredo do adaptador."
      }
    }
  },
  "x-planejamento": "v0.14",
  "x-estado": "proposto-nao-implementado",
  "x-audiencia": "tecnico"
}
