### Novo atendimento — Salvar atendimento completo e seus itens
# post_atendimentos
POST {{baseUrl}}/atendimentos
X-CSRF-Token: {{csrf}}
Idempotency-Key: {{idempotencyKey}}
Content-Type: application/json

{
  "titulo": "Pedido de iluminação",
  "descricao": "Solicita verificação da iluminação da rua.",
  "canal": "presencial",
  "situacao": "aberto",
  "servicos": [
    {
      "chave": "servico-1",
      "tipoServicoId": "33333333-3333-4333-8333-333333333333",
      "ocorridoEm": "2026-11-16T17:00:00Z",
      "situacao": "planejado"
    }
  ],
  "pendencias": [
    {
      "chave": "pendencia-1",
      "descricao": "Consultar retorno.",
      "situacao": "aberta"
    }
  ],
  "anexos": [
    {
      "chave": "anexo-1",
      "uploadToken": "upload-anexo-exemplo",
      "execucaoChave": "servico-1",
      "descricao": "Comprovante apresentado."
    }
  ],
  "notas": [
    {
      "chave": "nota-1",
      "texto": "Aguardar retorno do órgão."
    }
  ],
  "solicitante": {
    "tipo": "existente",
    "municipeId": "11111111-1111-4111-8111-111111111111"
  },
  "rascunhoId": "11111111-1111-4111-8111-111111111111"
}

### Ficha de atendimento — Abrir pedido pronto para editar
# get_atendimentos_id
GET {{baseUrl}}/atendimentos/{{id}}

### Ficha de atendimento — Salvar edição ou conclusão com todos os itens
# patch_atendimentos_id
PATCH {{baseUrl}}/atendimentos/{{id}}
X-CSRF-Token: {{csrf}}
Idempotency-Key: {{idempotencyKey}}
If-Match: {{etag}}
Content-Type: application/json

{
  "situacao": "concluido",
  "resultado": "Orientação prestada.",
  "motivoAlteracao": "Retorno conferido pela equipe.",
  "pendencias": [
    {
      "chave": "pendencia-1",
      "id": "11111111-1111-4111-8111-111111111111",
      "descricao": "Consultar retorno.",
      "situacao": "concluida",
      "resultado": "Retorno consultado."
    }
  ]
}

