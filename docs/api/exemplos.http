        "11111111-1111-4111-8111-111111111111"
      ],
      "abertura": {
        "modo": "componentes",
        "dia": 15,
        "mes": 11,
        "ano": 1990
      },
      "conclusao": {
        "modo": "componentes",
        "dia": 15,
