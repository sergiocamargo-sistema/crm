PATCH {{baseUrl}}/formularios/{{id}}/participantes/{{id}}
X-CSRF-Token: {{csrf}}
Idempotency-Key: {{idempotencyKey}}
If-Match: {{etag}}
Content-Type: application/json

{
  "situacao": "inscrito",
  "presencaEm": "2026-11-16T17:00:00Z",
  "observacao": "Participação conferida."
}

