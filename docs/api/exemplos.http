### Ativar notificações do Chrome — Vincular ou atualizar inscrição deste navegador
# post_notificacoes_inscricoes
POST {{baseUrl}}/notificacoes/inscricoes
X-CSRF-Token: {{csrf}}
Idempotency-Key: {{idempotencyKey}}
Content-Type: application/json

{
  "dispositivoChave": "11111111-1111-4111-8111-111111111111",
  "nomeDispositivo": "Chrome da recepção",
  "endpoint": "https://push.example.invalid/sub/exemplo",
  "p256dh": "chave-publica-exemplo",
  "auth": "auth-exemplo",
  "conexaoIds": [
    "11111111-1111-4111-8111-111111111111"
  ]
}

### Desativar notificações deste navegador — Desvincular inscrição própria
# delete_notificacoes_inscricoes_id
DELETE {{baseUrl}}/notificacoes/inscricoes/{{id}}
X-CSRF-Token: {{csrf}}
Idempotency-Key: {{idempotencyKey}}
X-Motivo: Ação conferida pela equipe.

### Testar notificações do Chrome — Enviar aviso de teste ao próprio dispositivo
# post_notificacoes_teste
POST {{baseUrl}}/notificacoes/teste
X-CSRF-Token: {{csrf}}
Idempotency-Key: {{idempotencyKey}}
Content-Type: application/json

{
  "inscricaoId": "11111111-1111-4111-8111-111111111111"
}

### Formulários e listas de presença — Listar formulários com evento, link e contadores
# get_formularios
GET {{baseUrl}}/formularios

### Editor de formulário e evento — Salvar evento e formulário, podendo abrir coleta
# post_formularios
POST {{baseUrl}}/formularios
X-CSRF-Token: {{csrf}}
Idempotency-Key: {{idempotencyKey}}
Content-Type: application/json

{
  "titulo": "Lista de presença",
  "descricao": "Informe seus dados para conferência.",
  "evento": {
    "id": "11111111-1111-4111-8111-111111111111",
    "nome": "Encontro de atendimento",
    "descricao": "Atendimento à comunidade.",
    "inicioEm": "2026-11-16T17:00:00Z",
    "fimEm": "2026-11-16T17:00:00Z",
    "local": "Espaço comunitário",
    "versao": 1
  },
  "finalidade": "inscricao",
  "camposAtivos": [
    "nome"
  ],
  "camposObrigatorios": [
    "nome"
  ],
  "abreEm": "2026-11-16T17:00:00Z",
  "fechaEm": "2026-11-16T17:00:00Z",
  "situacao": "rascunho"
}

### Editor de formulário e evento — Abrir editor novo ou existente com contexto completo
# get_formularios_editor
GET {{baseUrl}}/formularios/editor

### Editor de formulário e evento — Salvar edição, encerrar, revogar ou trocar link
# patch_formularios_id
PATCH {{baseUrl}}/formularios/{{id}}
X-CSRF-Token: {{csrf}}
Idempotency-Key: {{idempotencyKey}}
If-Match: {{etag}}
Content-Type: application/json

{
  "titulo": "Lista de presença",
  "descricao": "Informe seus dados para conferência.",
  "evento": {
    "id": "11111111-1111-4111-8111-111111111111",
    "nome": "Encontro de atendimento",
    "descricao": "Atendimento à comunidade.",
    "inicioEm": "2026-11-16T17:00:00Z",
    "fimEm": "2026-11-16T17:00:00Z",
    "local": "Espaço comunitário",
    "versao": 1
  },
  "finalidade": "inscricao",
  "camposAtivos": [
    "nome"
  ],
  "camposObrigatorios": [
    "nome"
  ],
  "abreEm": "2026-11-16T17:00:00Z",
  "fechaEm": "2026-11-16T17:00:00Z",
  "situacao": "rascunho",
  "gerarNovoLink": false,
  "motivoAlteracao": "Encerramento da coleta."
}

### Autocadastro pelo link — Abrir formulário público com todos os campos/opções
# get_publico_formularios_token
GET {{baseUrl}}/publico/formularios/{{token}}

### Autocadastro pelo link — Enviar cadastro temporário completo
# post_publico_formularios_token_envios
POST {{baseUrl}}/publico/formularios/{{token}}/envios
Idempotency-Key: {{idempotencyKey}}
Content-Type: application/json

{
  "versaoFormulario": 1,
  "dados": {
    "nome": "Ana Exemplo"
  }
}

### Participantes da ação — Listar inscrições e presenças prontas para conferência
# get_formularios_id_participantes
GET {{baseUrl}}/formularios/{{id}}/participantes

### Incluir participação pela equipe — Registrar participante existente ou novo completo
# post_formularios_id_participantes
POST {{baseUrl}}/formularios/{{id}}/participantes
X-CSRF-Token: {{csrf}}
Idempotency-Key: {{idempotencyKey}}
Content-Type: application/json

{
  "solicitante": {
    "tipo": "existente",
    "municipeId": "11111111-1111-4111-8111-111111111111"
  },
  "situacao": "inscrito",
  "presencaEm": "2026-11-16T17:00:00Z",
  "observacao": "Participação registrada pela equipe."
}

### Participantes da ação — Confirmar presença ou corrigir participação
