    "uf": "SP",
    "cep": "01001000",
    "logradouro": "Rua Exemplo",
    "documento": "DOC-EXEMPLO",
    "contato": "+5511999990000",
    "atendimento": {
      "existe": true,
      "situacoes": [
        "aberto"
      ],
      "servicoIds": [
        "11111111-1111-4111-8111-111111111111"
      ],
