### Configurações do gabinete — Carregar formulário de configurações autorizado
# get_administracao_configuracoes
GET {{baseUrl}}/administracao/configuracoes

### Configurações do gabinete — Salvar blocos alterados em uma ação
# patch_administracao_configuracoes
PATCH {{baseUrl}}/administracao/configuracoes
X-CSRF-Token: {{csrf}}
Idempotency-Key: {{idempotencyKey}}
If-Match: {{etag}}
Content-Type: application/json

{
  "institucional": {
    "nome": "Gabinete Exemplo",
    "descricaoPublica": "Atendimento à comunidade.",
    "contatoPublico": "contato@example.invalid"
  },
  "contato": {
    "janelaDias": 90,
    "diasRetomada": 90,
    "intervaloTentativasDias": 7
  },
  "whatsapp": {
    "limiarQuedaSegundos": 60,
    "maxTentativasAutomaticas": 3,
    "politicaIa": "assistida"
  },
  "retencao": {
    "recuperacaoExclusaoDias": 90,
    "rascunhosDias": 7,
    "documentosGeradosHoras": 24
  },
  "limites": {
    "maxUploadBytes": 26214400,
    "maxArquivosPorLote": 10,
    "maxAudioSegundos": 600,
    "maxObservacaoCaracteres": 100000,
    "mimeTypes": [
      "application/pdf"
    ],
    "maxItensPorColecao": 100,
    "maxDestinatariosEtiquetas": 5000
  },
  "sexos": [
    {
      "codigo": "nao_informado",
      "rotulo": "Não informado",
      "ativo": true
    }
  ]
}

